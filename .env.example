# Copy to .env (never commit .env). In Azure, set these as Container Apps secrets.
HUBSPOT_TOKEN=          # HubSpot private-app token (read-only scopes)
CLAUDE_CODE_OAUTH_TOKEN= # from `claude setup-token` (subscription auth)
# Do NOT set ANTHROPIC_API_KEY - it overrides the subscription and bills the API.
API_TOKEN=              # bearer token the dashboard sends to the API
DATA_DIR=data
MIN_SAMPLE=20
# CLAUDE_MODEL=         # optional override
