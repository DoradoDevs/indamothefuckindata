# Copy to .env for local runs (never commit .env). In Azure these live in Key Vault;
# see docs/DEPLOY.md. Check everything with: python -m pipeline.preflight --live

# --- HubSpot (required for real runs) ---
HUBSPOT_TOKEN=            # admin-issued read-only private app token
EXCLUDE_CONTACT_IDS=      # comma-separated HubSpot IDs to drop (HubSpot's sample contacts)

# --- Matching key (required) ---
HASH_SALT=                # 64 random hex chars; never change once runs exist

# --- Salesforce (optional; enables the Service deals page) ---
SF_LOGIN_URL=             # e.g. https://<my-domain>.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_API_VERSION=v61.0

# --- Claude (subscription) ---
CLAUDE_CODE_OAUTH_TOKEN=  # from `claude setup-token`
# Do NOT set ANTHROPIC_API_KEY - it overrides the subscription and bills the API.
# CLAUDE_MODEL=           # optional override

# --- Dashboard / storage ---
API_TOKEN=                # bearer token for the API if not behind Entra ID sign-in
DATA_DIR=data
MIN_SAMPLE=20
CONVERTED_STAGES=customer # lifecycle stage values that count as the goal (INDATEL: customer,2294533870)
ANALYSIS_CONTEXT=         # optional text file with business context for the Claude passes
